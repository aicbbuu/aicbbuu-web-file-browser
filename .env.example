# ===================== aicbbuu网页文件浏览 环境变量样例 =====================
# 用法：把需要的项复制到 ~/.config/web-file-browser.env（chmod 600），
#       再由 systemd 用 EnvironmentFile 加载；或临时导出后直接跑脚本。
#
#   cp .env.example ~/.config/web-file-browser.env
#   chmod 600 ~/.config/web-file-browser.env
#   vi ~/.config/web-file-browser.env
#
# 注意：这个文件里有密码，权限务必 600，也不要提交进 git。

# ---------- 必填 ----------
# 登录密码。不设置会拒绝启动（程序不内置任何默认口令）。
RESOURCE_PASSWORD=换成你自己的强密码

# ---------- 常用 ----------
# 登录账号
RESOURCE_USER=admin

# 要共享出去的目录（默认 ~/resource）
RESOURCE_DIR=/home/你的用户名/resource

# 监听端口。默认 443 —— 局域网里直接 https://<IP>/ 就能访问，不用记端口。
# 443 是特权端口，systemd 会用 AmbientCapabilities 单独授权（见 install.sh）。
# 换端口举例：8443
RESOURCE_PORT=443

# 监听地址。0.0.0.0 = 所有网卡都能访问；只给自己用可改成 127.0.0.1
RESOURCE_HOST=0.0.0.0

# ---------- 可选 ----------
# 是否启用 HTTPS（1 开 / 0 关）。证书不存在时会自动降级成 HTTP，不会启动失败。
RESOURCE_TLS=1

# 自定义证书路径（默认项目内 certs/server.crt 与 certs/server.key）
# RESOURCE_TLS_CERT=/etc/ssl/mycert.pem
# RESOURCE_TLS_KEY=/etc/ssl/mykey.pem

# 数据目录（会话、分享、回收站、编辑历史。默认项目内 data/）
# RESOURCE_DATA_DIR=/var/lib/web-file-browser
